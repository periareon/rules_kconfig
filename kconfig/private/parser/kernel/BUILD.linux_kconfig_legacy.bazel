# The Kconfig parser of Linux {tag} (scripts/kconfig, GPL-2.0), with the
# exits of `conf` reporting to the host (host_{version}.patch), as
# rules_kconfig's parser links it.
# Generated by rules_kconfig's `kernel_kconfig_repository` from
# BUILD.linux_kconfig_legacy.bazel.
load("@bison//:bison.bzl", "bison")
load("@flex//:flex.bzl", "flex")
load("@rules_cc//cc:defs.bzl", "cc_library")

# The command lines of the kernel's build (scripts/Makefile.lib, `cmd_bison`
# and `cmd_flex`), with its output names. The kernels of this age build the
# parser as one translation unit: zconf.y includes zconf.lex.c, kconf_id.c
# and the other sources.
bison(
    name = "zconf.tab",
    srcs = ["zconf.y"],
    outs = [
        "zconf.tab.c",
        "zconf.tab.h",
    ],
    args = [
        "-o",
        "$(execpath zconf.tab.c)",
        "--defines=$(execpath zconf.tab.h)",
        "-t",
        "-l",
        "$(execpath zconf.y)",
    ],
)

flex(
    name = "zconf.lex",
    srcs = ["zconf.l"],
    outs = ["zconf.lex.c"],
    args = [
        "-o",
        "$(execpath zconf.lex.c)",
        "-L",
        "$(execpath zconf.l)",
    ],
)

# The parser cannot reach files, the environment or a shell from inside the
# module, so the libc functions it calls for them are renamed to the shim's:
# the translation unit is compiled with `host.h` included first, which
# declares them and renames at its end (see host.h); and with `prefix_{id}.h`
# before it, which renames every exported name of the parser, so that the
# parsers of several releases link into one program. Everything else is the
# kernel's code as released. The Windows CRT lacks three POSIX headers the
# sources include; `compat_windows` stands in for them there.
cc_library(
    name = "kconfig",
    srcs = [":zconf.tab"],
    hdrs = glob(["*.h"]),
    copts = select({
        "@platforms//os:windows": [
            "/FIprefix_{id}.h",
            "/FIhost.h",
        ],
        "//conditions:default": [
            "-include",
            "prefix_{id}.h",
            "-include",
            "host.h",
        ],
    }) + [
        # The declarations the renamed calls go through, in wasi-libc's headers.
        "-D_WASI_EMULATED_GETPID",
        "-D_WASI_EMULATED_MMAN",
        # The kernel runs bison with `-t`; zconf.y refers to `yydebug`.
        "-DYYDEBUG=1",
    ],
    # The release, for the shim's version-dependent code and its
    # `kconfig_shim_kernel_version`.
    defines = [
        "RULES_KCONFIG_KERNEL_MAJOR={major}",
        "RULES_KCONFIG_KERNEL_MINOR={minor}",
    ],
    includes = ["."],
    # What zconf.y includes.
    textual_hdrs = [
        "confdata.c",
        "expr.c",
        "kconf_id.c",
        "menu.c",
        "preprocess.c",
        "symbol.c",
        "util.c",
        ":zconf.lex",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_kconfig//kconfig/private/parser/kernel:host",
        "@rules_kconfig//kconfig/private/parser/kernel:prefix_{id}",
    ] + select({
        "@platforms//os:windows": ["@rules_kconfig//kconfig/private/parser/kernel:compat_windows"],
        "//conditions:default": [],
    }),
)
