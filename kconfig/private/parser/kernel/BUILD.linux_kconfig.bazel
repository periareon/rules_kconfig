# The Kconfig parser of Linux {tag} (scripts/kconfig, GPL-2.0), with the
# exits of `conf` reporting to the host (host_{version}.patch), as
# rules_kconfig's parser links it.
# Generated by rules_kconfig's `kernel_kconfig_repository` from
# BUILD.linux_kconfig.bazel.
load("@bison//:bison.bzl", "bison")
load("@flex//:flex.bzl", "flex")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_library")

# The command lines of the kernel's build (scripts/Makefile.lib, `cmd_bison`
# and `cmd_flex`), with its output names; lexer.l includes parser.tab.h.
bison(
    name = "parser.tab",
    srcs = ["parser.y"],
    outs = [
        "parser.tab.c",
        "parser.tab.h",
    ],
    args = [
        "-o",
        "$(execpath parser.tab.c)",
        "--defines=$(execpath parser.tab.h)",
        "-t",
        "-l",
        "$(execpath parser.y)",
    ],
)

flex(
    name = "lexer.lex",
    srcs = ["lexer.l"],
    outs = ["lexer.lex.c"],
    args = [
        "-o",
        "$(execpath lexer.lex.c)",
        "-L",
        "$(execpath lexer.l)",
    ],
)

# The parser cannot reach files, the environment or a shell from inside the
# module, so the libc functions it calls for them are renamed to the shim's:
# every source is compiled with `host.h` included first, which declares them
# and renames at its end (see host.h); and with `prefix_{id}.h` before it,
# which renames every exported name of the parser, so that the parsers of
# several releases link into one program. Everything else is the kernel's
# code as released. The Windows CRT lacks three POSIX headers the sources
# include; `compat_windows` stands in for them there. `include/` is the
# kernel's `scripts/include`, which the sources take with `-I`.
cc_library(
    name = "kconfig",
    srcs = [
        "confdata.c",
        "expr.c",
        "menu.c",
        "preprocess.c",
        "symbol.c",
        "util.c",
        ":lexer.lex",
        ":parser.tab",
    ],
    hdrs = glob([
        "*.h",
        "include/*.h",
    ]),
    copts = select({
        "@platforms//os:windows": [
            "/FIprefix_{id}.h",
            "/FIhost.h",
        ],
        "//conditions:default": [
            "-include",
            "prefix_{id}.h",
            "-include",
            "host.h",
        ],
    }) + [
        # The declarations the renamed calls go through, in wasi-libc's headers.
        "-D_WASI_EMULATED_GETPID",
        "-D_WASI_EMULATED_MMAN",
        # The kernel runs bison with `-t`; parser.y refers to `yydebug`.
        "-DYYDEBUG=1",
    ],
    # The release, for the shim's version-dependent code and its
    # `kconfig_shim_kernel_version`.
    defines = [
        "RULES_KCONFIG_KERNEL_MAJOR={major}",
        "RULES_KCONFIG_KERNEL_MINOR={minor}",
    ],
    includes = [
        ".",
        "include",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_kconfig//kconfig/private/parser/kernel:host",
        "@rules_kconfig//kconfig/private/parser/kernel:prefix_{id}",
    ] + select({
        "@platforms//os:windows": ["@rules_kconfig//kconfig/private/parser/kernel:compat_windows"],
        "//conditions:default": [],
    }),
)

# mconf, the kernel's menuconfig: scripts/kconfig/mconf.c over the lxdialog
# widgets and the parser as released (menuconfig/, unpatched), linked with the
# registry's ncurses; `menuconfig` runs it on the machine `bazel run` is
# on. scripts/kconfig/Makefile's mconf-cfg.sh asks pkg-config for the
# curses flags; here they are the ncurses module's.
bison(
    name = "menuconfig/parser.tab",
    srcs = ["menuconfig/parser.y"],
    outs = [
        "menuconfig/parser.tab.c",
        "menuconfig/parser.tab.h",
    ],
    args = [
        "-o",
        "$(execpath menuconfig/parser.tab.c)",
        "--defines=$(execpath menuconfig/parser.tab.h)",
        "-t",
        "-l",
        "$(execpath menuconfig/parser.y)",
    ],
)

flex(
    name = "menuconfig/lexer.lex",
    srcs = ["menuconfig/lexer.l"],
    outs = ["menuconfig/lexer.lex.c"],
    args = [
        "-o",
        "$(execpath menuconfig/lexer.lex.c)",
        "-L",
        "$(execpath menuconfig/lexer.l)",
    ],
)

cc_library(
    name = "mconf_parser",
    srcs = [
        "menuconfig/confdata.c",
        "menuconfig/expr.c",
        "menuconfig/menu.c",
        "menuconfig/preprocess.c",
        "menuconfig/symbol.c",
        "menuconfig/util.c",
        ":menuconfig/lexer.lex",
        ":menuconfig/parser.tab",
    ],
    hdrs = glob([
        "menuconfig/*.h",
        "menuconfig/include/*.h",
    ]),
    copts = ["-DYYDEBUG=1"],
    includes = [
        "menuconfig",
        "menuconfig/include",
    ],
    # mconf is a curses program over POSIX (unistd.h, termios): not for
    # Windows, where a `menuconfig` is incompatible and `//...` skips it.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "mconf",
    srcs = glob([
        "menuconfig/lxdialog/*.c",
        "menuconfig/lxdialog/*.h",
    ]) + [
        "menuconfig/mconf.c",
        "menuconfig/mnconf-common.c",
    ],
    # mconf is a curses program over POSIX (unistd.h, termios): not for
    # Windows, where a `menuconfig` is incompatible and `//...` skips it.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":mconf_parser",
        "@ncurses",
    ],
)
