load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//kconfig/private:versions.bzl", "PARSER_VERSIONS")
load(":parser.bzl", "kconfig_parser_test", "kconfig_parsers", "kconfig_shim")

# The parser the repository rules run: the Linux kernel's Kconfig parser of
# each release //kconfig/private:versions.bzl lists (fetched by
# kernel/repository.bzl), each behind shim.c, and the generators in Rust, as
# one program: a WebAssembly module Bazel runs through
# `repository_ctx.execute_wasm`, and a native build. See src/lib.rs for the
# protocol and parser.bzl for how the parsers share a program.
#
# `:kconfig_wasm` is built for `wasm32-wasip1` (`--config=wasm32`), with the
# wasi-sdk toolchain of //tools/wasi_sdk for the C and rules_rust's toolchain
# for the Rust; a release attaches it as `kconfig.wasm`, which module.bzl
# names. `:kconfig_tool` is the same code as a native program, which the tests
# run, and which a release attaches per platform as `kconfig_tool-<os>-<cpu>`
# for the Bazels that cannot run the module.

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

[
    kconfig_shim(
        version = version,
    )
    for version in PARSER_VERSIONS
]

kconfig_parsers(
    name = "parsers",
    versions = PARSER_VERSIONS,
)

rust_library(
    name = "kconfig",
    srcs = glob(
        ["src/*.rs"],
        exclude = [
            "src/main.rs",
            "src/wasm.rs",
        ],
    ),
    crate_root = "src/lib.rs",
    link_deps = [":parsers"],
    deps = [
        "@crates//:indexmap",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_bytes",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "kconfig_test",
    crate = ":kconfig",
)

rust_binary(
    name = "kconfig_tool",
    srcs = ["src/main.rs"],
    visibility = ["//visibility:public"],
    deps = [":kconfig"],
)

rust_shared_library(
    name = "kconfig_wasm",
    srcs = ["src/wasm.rs"],
    crate_root = "src/wasm.rs",
    target_compatible_with = ["@platforms//os:wasi"],
    visibility = ["//visibility:public"],
    deps = [":kconfig"],
)

[
    kconfig_parser_test(
        version = version,
    )
    for version in PARSER_VERSIONS
]

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]) + ["//:version.bzl"],
    visibility = ["//kconfig/private:__pkg__"],
    deps = [
        "//kconfig/private:versions_bzl_lib",
        "//kconfig/private/parser/kernel:bzl_lib",
    ],
)
