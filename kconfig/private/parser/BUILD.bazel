load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//kconfig/private:versions.bzl", "PARSER_VERSIONS")
load("//tools/release:defs.bzl", "release_artifact")
load(":module.bzl", "MODULE_URL", "TOOL_URLS")
load(":parser.bzl", "kconfig_parser_test", "kconfig_parsers", "kconfig_shim")

# The parser the repository rules run: the Linux kernel's Kconfig parser of
# each release //kconfig/private:versions.bzl lists (fetched by
# kernel/repository.bzl), each behind shim.c, and the generators in Rust, as
# one program: a WebAssembly module Bazel runs through
# `repository_ctx.execute_wasm`, and a native build. See src/lib.rs for the
# protocol and parser.bzl for how the parsers share a program.
#
# `:kconfig_wasm` is built for `wasm32-wasip1` (`--config=wasm32`), with the
# wasi-sdk toolchain of //tools/wasi_sdk for the C and rules_rust's toolchain
# for the Rust; a release attaches it as `kconfig.wasm`, which module.bzl
# names. `:kconfig_tool` is the same code as a native program, which the tests
# run, and which a release attaches per platform as `kconfig_tool-<os>-<cpu>`
# for the Bazels that cannot run the module.

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

[
    kconfig_shim(
        version = version,
    )
    for version in PARSER_VERSIONS
]

kconfig_parsers(
    name = "parsers",
    versions = PARSER_VERSIONS,
)

rust_library(
    name = "kconfig",
    srcs = glob(
        ["src/*.rs"],
        exclude = [
            "src/main.rs",
            "src/wasm.rs",
        ],
    ),
    crate_root = "src/lib.rs",
    link_deps = [":parsers"],
    deps = [
        "@crates//:indexmap",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_bytes",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "kconfig_test",
    crate = ":kconfig",
)

rust_binary(
    name = "kconfig_tool",
    srcs = ["src/main.rs"],
    # A musl build links statically, and a static link takes an archive's
    # members where the archive is listed: rules_rust lists the C parsers
    # again after rustc's own `-lc`, so libc is listed once more at the end,
    # for the symbols only the parsers use.
    rustc_flags = select({
        "//tools/platforms:musl": ["-Clink-arg=-lc"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":kconfig"],
)

rust_shared_library(
    name = "kconfig_wasm",
    srcs = ["src/wasm.rs"],
    crate_root = "src/wasm.rs",
    target_compatible_with = ["@platforms//os:wasi"],
    visibility = ["//visibility:public"],
    deps = [":kconfig"],
)

[
    kconfig_parser_test(
        version = version,
    )
    for version in PARSER_VERSIONS
]

# The release assets, named as module.bzl names them: `bazel run` builds the
# asset in opt and copies it into the directory given as the argument.
# release_prep.sh runs the first; the `binaries` job of release.yaml runs
# the second on macOS and Windows, for the host, and the Linux ones on a
# Linux runner, for musl (see tools/platforms), so that one build runs on
# any glibc. Manual, as `//...` would otherwise build the module on every
# platform CI tests on.
release_artifact(
    name = "kconfig_wasm_release",
    src = ":kconfig_wasm",
    out = MODULE_URL.rsplit("/", 1)[-1],
    platform = "//tools/wasi_sdk:wasm32-wasip1",
    tags = ["manual"],
)

release_artifact(
    name = "kconfig_tool_release",
    src = ":kconfig_tool",
    out = select(
        {
            "//tools/constraints:" + key: url.rsplit("/", 1)[-1]
            for key, url in TOOL_URLS.items()
        },
        no_match_error = "a release carries no native build for this platform; see TOOL_URLS of module.bzl",
    ),
    tags = ["manual"],
)

[
    release_artifact(
        name = "kconfig_tool_release_linux_" + cpu,
        src = ":kconfig_tool",
        out = TOOL_URLS["linux-" + cpu].rsplit("/", 1)[-1],
        platform = "//tools/platforms:linux-{}-musl".format(cpu),
        tags = ["manual"],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]) + ["//:version.bzl"],
    visibility = ["//kconfig/private:__pkg__"],
    deps = [
        "//kconfig/private:versions_bzl_lib",
        "//kconfig/private/parser/kernel:bzl_lib",
    ],
)
