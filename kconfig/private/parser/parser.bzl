"""The parser's targets: one program with the kernel's parser of every release.

The kernel's parser is C with global names, so each release's copy (the
`kconfig` library of its `kernel_kconfig_<id>` repository) and the copy of
shim.c over it are compiled with the release's prefix header
(`kernel/prefix_<id>.h`), which renames every exported name, and reached
through the table shim.c defines; `parsers.c`, generated here, lists the
tables for the Rust side, newest first. `kconfig_tool` and `kconfig_wasm`
are then the one native build and the one module, and `parser_test_<id>`
runs the native build against the goldens of `testdata/<version>`.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_venv//python/pytest:defs.bzl", "py_pytest_test")
load("//kconfig/private:versions.bzl", "version_id")
load("//kconfig/private/parser/kernel:repository.bzl", "kernel_kconfig_repository_name")

def _prefix_copts(id):
    return select({
        "@platforms//os:windows": ["/FIprefix_{}.h".format(id)],
        "//conditions:default": [
            "-include",
            "prefix_{}.h".format(id),
        ],
    })

def kconfig_shim(version):
    """shim.c over the kernel's parser of one release, under the release's prefix.

    Args:
        version: One of `PARSER_VERSIONS`.

    Returns:
        str: The name of the `cc_library`, `shim_<id>`.
    """
    id = version_id(version)
    name = "shim_" + id
    cc_library(
        name = name,
        srcs = ["shim.c"],
        hdrs = ["shim.h"],
        copts = _prefix_copts(id),
        deps = [
            "//kconfig/private/parser/kernel:host",
            "//kconfig/private/parser/kernel:prefix_" + id,
            "@{}//:kconfig".format(kernel_kconfig_repository_name(version)),
        ] + select({
            "@platforms//os:windows": ["//kconfig/private/parser/kernel:compat_windows"],
            "//conditions:default": [],
        }),
    )
    return name

def kconfig_parsers(name, versions):
    """The tables of every release's parser, newest first, for the Rust side.

    Inside the module nothing may be imported, so the WASI functions
    wasi-libc and Rust's std import are compiled in as stubs here as well.

    Args:
        name: The name of the `cc_library`.
        versions: `PARSER_VERSIONS`.
    """
    ids = [version_id(version) for version in versions]
    write_file(
        name = name + "_c",
        out = "parsers.c",
        content = [
            "/* Generated by kconfig_parsers of parser.bzl: the tables of the parsers",
            " * linked in (see shim.h), newest first. */",
            "#include \"shim.h\"",
            "",
        ] + [
            "extern const struct kconfig_shim v{}_kconfig_shim_vtable;".format(id)
            for id in ids
        ] + [
            "",
            "const struct kconfig_shim* const kconfig_parsers[] = {",
        ] + [
            "    &v{}_kconfig_shim_vtable,".format(id)
            for id in ids
        ] + [
            "    NULL,",
            "};",
            "",
        ],
    )
    cc_library(
        name = name,
        srcs = ["parsers.c"] + select({
            "@platforms//os:wasi": ["wasi_stubs.c"],
            "//conditions:default": [],
        }),
        hdrs = ["shim.h"],
        # parsers.c is generated, and includes shim.h from the source tree.
        includes = ["."],
        deps = [":shim_" + id for id in ids],
    )

def kconfig_parser_test(version):
    """The native build against the goldens of one release; see parser_test.py.

    Args:
        version: One of `PARSER_VERSIONS`.
    """
    py_pytest_test(
        name = "parser_test_" + version_id(version),
        srcs = ["parser_test.py"],
        data = [":kconfig_tool"] + native.glob(["testdata/{}/**".format(version)]),
        env = {
            "KCONFIG_TOOL": "$(rlocationpath :kconfig_tool)",
            "KCONFIG_VERSION": version,
        },
        deps = ["@rules_venv//python/runfiles"],
    )
