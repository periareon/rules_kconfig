load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The launcher of the `menuconfig` rule: a small program that sets the
# environment the kernel's `mconf` reads and runs it (see main.cc). Built from
# source by every consumer, with the C++ toolchain `mconf` needs anyway and
# rules_cc's runfiles library; nothing else.
cc_library(
    name = "launcher",
    srcs = ["launcher.cc"],
    hdrs = ["launcher.h"],
)

cc_binary(
    name = "menuconfig",
    srcs = ["main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":launcher",
        "@rules_cc//cc/runfiles",
    ],
)

cc_test(
    name = "menuconfig_test",
    size = "small",
    srcs = ["launcher_test.cc"],
    deps = [":launcher"],
)
