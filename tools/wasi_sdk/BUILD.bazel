load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# The platform of the WebAssembly module: `--platforms=//tools/wasi_sdk:wasm32-wasip1`
# builds a C target with the wasi-sdk toolchain of `@wasi_sdk` (see repository.bzl).
platform(
    name = "wasm32-wasip1",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)
