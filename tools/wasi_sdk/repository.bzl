"""The wasi-sdk, as a C++ toolchain for `wasm32-wasip1`.

Bazel's C++ rules compile for the platform `--platforms` names with whichever
registered `cc_toolchain` matches it. The WebAssembly module links the kernel's
parser (`@kernel_kconfig//:kconfig`), a `cc_library`, into Rust built for
`wasm32-wasip1`; rules_rust links with its own `rust-lld`, but the C needs a
toolchain for the platform. This repository rule downloads the wasi-sdk release
for the host, and writes a `cc_toolchain` over it for the `wasm32-wasip1`
platform of `//tools/wasi_sdk`, with the configuration of toolchain_config.bzl.
MODULE.bazel registers it as a dev dependency:

    bazel build --config=wasm32 //kconfig/private/parser:kconfig_wasm
"""

_VERSION = "33.0"

_URL = "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-33/wasi-sdk-{version}-{host}.tar.gz"

# The clang the release ships; its resource directory is `lib/clang/<major>`.
_CLANG_MAJOR = "22"

# The release's archive per host, by `<os>-<cpu>` of the host, with the SHA-256
# the release publishes and the constraints of the execution platform.
_HOSTS = {
    "linux-aarch64": struct(
        name = "arm64-linux",
        sha256 = "4f98ee738c7abb45c81a94d1461fc53cc569d1cd01498951c8184d841a027844",
        constraints = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
    ),
    "linux-x86_64": struct(
        name = "x86_64-linux",
        sha256 = "0ba8b5bfaeb2adf3f29bab5841d76cf5318ab8e1642ea195f88baba1abd47bce",
        constraints = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    ),
    "macos-aarch64": struct(
        name = "arm64-macos",
        sha256 = "85c997a2665ead91673b5bb88b7d0df3fc8900df3bfa244f720d478187bbdc78",
        constraints = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    ),
    "macos-x86_64": struct(
        name = "x86_64-macos",
        sha256 = "18f3f201ba9734e6a4455b0b6410690395a55e9ffa9f6f5066f66083a94b93b3",
        constraints = ["@platforms//os:macos", "@platforms//cpu:x86_64"],
    ),
    "windows-aarch64": struct(
        name = "arm64-windows",
        sha256 = "2f457a62da1ce1a55e2ba77c450401b3551f27f04f0a87112b74c5aa8dd9504f",
        constraints = ["@platforms//os:windows", "@platforms//cpu:aarch64"],
    ),
    "windows-x86_64": struct(
        name = "x86_64-windows",
        sha256 = "df14ca2a2127c2d6b6be07e6f5549b3af9c1b3c0112430c200a4749970c59f06",
        constraints = ["@platforms//os:windows", "@platforms//cpu:x86_64"],
    ),
}

_BUILD = '''\
# wasi-sdk {version} for the host, as a C++ toolchain for `wasm32-wasip1`.
# Generated by rules_kconfig's `wasi_sdk_repository` (tools/wasi_sdk).
load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@rules_kconfig//tools/wasi_sdk:toolchain_config.bzl", "wasi_sdk_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# clang loads libLLVM and libclang-cpp from `lib`, and finds its resource
# directory (`lib/clang/{clang_major}`) and the sysroot relative to itself.
filegroup(
    name = "compiler_files",
    srcs = glob([
        "bin/clang*",
        "lib/*.so*",
        "lib/*.dylib",
        "lib/clang/**",
        "share/wasi-sysroot/include/**",
    ], allow_empty = True),
)

filegroup(
    name = "linker_files",
    srcs = glob([
        "bin/clang*",
        "bin/wasm-ld*",
        "bin/lld*",
        "bin/llvm-ar*",
        "lib/*.so*",
        "lib/*.dylib",
        "lib/clang/**",
        "share/wasi-sysroot/lib/**",
    ], allow_empty = True),
)

filegroup(
    name = "ar_files",
    srcs = ["bin/llvm-ar{exe}"],
)

filegroup(
    name = "all_files",
    srcs = [
        ":ar_files",
        ":compiler_files",
        ":linker_files",
    ] + glob(["bin/llvm-*"]),
)

filegroup(name = "empty")

wasi_sdk_cc_toolchain_config(
    name = "cc_toolchain_config",
    clang_major = "{clang_major}",
    exe = "{exe}",
    sdk = "external/{repo}",
    version = "{version}",
)

cc_toolchain(
    name = "cc_toolchain",
    all_files = ":all_files",
    ar_files = ":ar_files",
    as_files = ":compiler_files",
    compiler_files = ":compiler_files",
    dwp_files = ":empty",
    linker_files = ":linker_files",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
    toolchain_config = ":cc_toolchain_config",
    toolchain_identifier = "wasi-sdk-{version}-wasm32-wasip1",
)

toolchain(
    name = "toolchain",
    exec_compatible_with = {exec_constraints},
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
    toolchain = ":cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
'''

def _host(repository_ctx):
    """The `<os>-<cpu>` key of the host in `_HOSTS`."""
    os_name = repository_ctx.os.name.lower()
    if os_name.startswith("linux"):
        os = "linux"
    elif os_name.startswith("mac"):
        os = "macos"
    elif os_name.startswith("windows"):
        os = "windows"
    else:
        fail("wasi-sdk has no release for the operating system `{}`".format(repository_ctx.os.name))

    arch = repository_ctx.os.arch.lower()
    if arch in ("amd64", "x86_64", "x64"):
        cpu = "x86_64"
    elif arch in ("aarch64", "arm64"):
        cpu = "aarch64"
    else:
        fail("wasi-sdk has no release for the CPU `{}`".format(repository_ctx.os.arch))

    return "{}-{}".format(os, cpu)

def _wasi_sdk_repository_impl(repository_ctx):
    key = _host(repository_ctx)
    host = _HOSTS[key]
    repository_ctx.download_and_extract(
        url = _URL.format(version = _VERSION, host = host.name),
        sha256 = host.sha256,
        stripPrefix = "wasi-sdk-{}-{}".format(_VERSION, host.name),
    )
    repository_ctx.file("BUILD.bazel", _BUILD.format(
        clang_major = _CLANG_MAJOR,
        exe = ".exe" if key.startswith("windows") else "",
        exec_constraints = json.encode(host.constraints),
        repo = repository_ctx.name,
        version = _VERSION,
    ))
    if hasattr(repository_ctx, "repo_metadata"):
        return repository_ctx.repo_metadata(reproducible = True)
    return None

wasi_sdk_repository = repository_rule(
    doc = "wasi-sdk {} for the host, with a `cc_toolchain` for `wasm32-wasip1` over it.".format(_VERSION),
    implementation = _wasi_sdk_repository_impl,
)
