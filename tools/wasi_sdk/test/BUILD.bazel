load("@rules_cc//cc:defs.bzl", "cc_binary")

# Compiled and linked only for the WebAssembly platform
# (`bazel build --config=wasm32 //tools/wasi_sdk/test:hello`); on any other
# platform the target is incompatible and skipped.
cc_binary(
    name = "hello",
    srcs = ["hello.c"],
    target_compatible_with = ["@platforms//os:wasi"],
)
