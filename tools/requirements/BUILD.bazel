load("@rules_req_compile//:defs.bzl", "py_reqs_compiler", "py_reqs_solution_test")

exports_files(glob(["*.txt"]))

filegroup(
    name = "requirements_in",
    srcs = [
        "dev_requirements.in",
    ],
    data = [
        "//kconfig:requirements.in",
    ],
)

# The solutions of every platform are compiled together, from any host, and
# share versions. The platform tags are the oldest each lock file is meant
# to install on; the `requirements` extension in MODULE.bazel maps each lock
# to its `//tools/constraints` setting.
py_reqs_compiler(
    name = "requirements.update",
    requirements_in = ":requirements_in",
    requirements_txts = {
        "requirements_linux_aarch64.txt": "manylinux_2_28_aarch64",
        "requirements_linux_x86_64.txt": "manylinux_2_28_x86_64",
        "requirements_macos_aarch64.txt": "macosx_11_0_arm64",
        "requirements_windows_x86_64.txt": "win_amd64",
    },
)

py_reqs_solution_test(
    name = "requirements_test",
    compiler = ":requirements.update",
)
